#:kivy 2.3.0

<SidebarButton@Button>:
    background_normal: ''
    background_color: 0, 0, 0, 0  # Transparent background
    icon_source: ''
    selected: False

    canvas.before:
        Color:
            rgba: (0.172, 0.251, 0.004, 0.55) if self.selected else (0, 0, 0, 0)  # Darker green if selected
        RoundedRectangle:
            pos: self.center_x - dp(30), self.center_y - dp(30)  # Adjust size & position
            size: dp(60), dp(60)
            radius: [dp(10), ]  # Rounded corners

    Image:
        source: root.icon_source
        size_hint: (0.8, 0.8)
        center_x: root.center_x
        center_y: root.center_y

<HeaderButton@Button>:
    font_size: "30sp"
    bold: True
    background_normal: ''
    background_color: 0, 0, 0, 0  # Transparent background
    color: 0.46, 0.61, 0.29, 1  # #759C4A Green

<CustomButton@Button>:
    font_size: "30sp"
    background_normal: ''
    background_color: 0, 0, 0, 0  # Transparent background
    color: 0.262, 0.262, 0.262, 1  # #434343
    canvas.before:
        Color:
            rgba: 0.78, 0.85, 0.68, 1  # Background color (#C7D9AD)
        RoundedRectangle:
            pos: self.pos
            size: self.size
            radius: [dp(10), ]  # Rounded corners

<PlantHomeScreen>:
    FloatLayout:
        canvas.before:
            Color:
                rgba: 1, 1, 1, 1  # White background
            Rectangle:
                pos: self.pos
                size: self.size

        # Title - If you have "title_text" still on MyApp, you can leave this as is:
        Label:
            text: app.greenhouse_data.title_text
            font_size: "45sp"
            color: 0.23, 0.23, 0.23, 1  # #3B3B3B
            halign: 'center'
            valign: 'top'
            padding_x: dp(30)
            text_size: self.size
            font_name: 'resources/fonts/nirmalab.ttf'

        Widget:
            canvas:
                Color:
                    rgba: 0.46, 0.61, 0.29, 1  # #759C4A Green
                Rectangle:
                    pos: (dp(200), dp(625)) 
                    size: dp(965), dp(5)

        # Sidebar
        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            width: dp(80)
            height: dp(666)
            pos: (dp(33), dp(25))
            canvas.before:
                Color:
                    rgba: 0.78, 0.85, 0.68, 1  # #C7D9AD
                RoundedRectangle:
                    pos: self.pos
                    size: self.size
                    radius: [dp(10), ]

            SidebarButton:
                icon_source: 'resources/icons/home.png'
                on_release: app.root.current = "home"

            SidebarButton:
                icon_source: 'resources/icons/leaves.png'
                selected: True 

            SidebarButton:
                icon_source: 'resources/icons/analytics.png'
                on_press: print("Not Implemented Yet!")

            SidebarButton:
                icon_source: 'resources/icons/nature.png'
                on_press: print("Not Implemented Yet!")

            SidebarButton:
                icon_source: 'resources/icons/settings.png'
                on_press: print("Not Implemented Yet!")

        # Main Content
        BoxLayout:
            orientation: 'vertical'
            size_hint: None, None
            size: dp(965), dp(490)
            pos: (dp(200), dp(133))
            canvas.before:
                Color:
                    rgba: 0.95, 0.95, 0.95, 0.5  # Slight grey
                Rectangle:
                    pos: self.pos
                    size: self.size

            BoxLayout:
                size_hint_y: None
                height: dp(60)
                spacing: dp(10)

                HeaderButton:
                    text: "Name"
                    on_release: root.sort_by("name") #Side note this sorting feature may have to be a app.sort_by I'm not sure if it will have to be in main or not

                HeaderButton:
                    text: "Status"
                    on_release: root.sort_by("status")

                HeaderButton:
                    text: "Location"
                    on_release: root.sort_by("location")

                HeaderButton:
                    text: "Card"
                    on_release: root.sort_by("card")

            RecycleView:
                id: plant_rv
                RecycleBoxLayout:
                    default_size: None, dp(60)
                    default_size_hint: 1, None
                    size_hint_y: None
                    height: self.minimum_height
                    orientation: 'vertical'        

        # Action Buttons
        BoxLayout:
            orientation: 'horizontal'
            size_hint: None, None
            size: dp(400), dp(50)
            pos: (dp(500), dp(50))
            spacing: dp(20)

            CustomButton:
                text: "Add"
                on_release: print("Add feature later")

            CustomButton:
                text: "Remove"
                on_release: print("Add feature later")

